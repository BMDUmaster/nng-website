<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Match trailing-slash canonicals
    RewriteRule ^(about|services|hand-holding-program|contact|consultation)$ $1/ [L,R=301]

    # Send Requests To Front Controller (Laravel owns all routes & views)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

<IfModule mod_headers.c>
    # Prevent browser caching of HTML/PHP dynamic pages so live changes show instantly
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>
