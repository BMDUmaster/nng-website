<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # --- MAINTENANCE MODE: ON ---------------------------------------------------------------------------------------
    # Every page shows maintenance.html (status 503, via maintenance.php) except the admin, the enquiry store, the
    # landing pages and the files they need. To switch maintenance off, delete this block down to "END MAINTENANCE".
    RewriteCond %{REQUEST_URI} !^/(admin|login|enquiry|landing)(/|$) [NC]
    RewriteCond %{REQUEST_URI} !^/(icon\.svg|favicon\.ico|robots\.txt)$ [NC]
    RewriteCond %{REQUEST_URI} !^/(images|_next|uploads|videos|build|css|js|fonts|storage)/ [NC]
    RewriteRule !^maintenance\.(php|html)$ maintenance.php [L]
    # --- END MAINTENANCE ------------------------------------------------------------------------------------------

    # Old landing-page addresses used in ads
    RewriteRule ^landing/psychic-reader(/.*)?$ /landing/brainology/ [R=301,L]
    RewriteRule ^landing/vastu(/.*)?$ /landing/vastulogy/ [R=301,L]

    # Match trailing-slash canonicals
    RewriteRule ^(about|services|hand-holding-program|contact|consultation)$ $1/ [L,R=301]

    # Send Requests To Front Controller (Laravel owns all routes & views)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_dir.c>
    # The redesigned website is static: a folder's index.html is the page. Anything without a file or folder
    # (admin, blog, enquiry store) still goes to Laravel through index.php.
    DirectoryIndex index.html index.php
</IfModule>

<IfModule mod_headers.c>
    # Prevent browser caching of HTML/PHP dynamic pages so live changes show instantly
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>
