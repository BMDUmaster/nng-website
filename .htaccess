<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Keep externally requested URLs canonical even on root document setups.
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L]

    # When the repository root is the document root, expose only public/.
    # Never serve an existing repository file (including composer.json or source).
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_dir.c>
    DirectoryIndex public/index.php index.php
</IfModule>
