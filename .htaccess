<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # When the repository root is the document root, expose only public/.
    # Never serve an existing repository file (including composer.json or source).
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_dir.c>
    DirectoryIndex public/index.php index.php
</IfModule>
